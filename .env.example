# Copy to .env.local (local) or set these in your hosting provider's environment settings.
# Never commit real values. Nothing in this file is read by the browser.

# ---------------------------------------------------------------- Database
# Any PostgreSQL, including Supabase. Use the *server-side* connection string
# (Supabase: Project Settings > Database > Connection string, "Transaction pooler" is fine).
# Leave empty to use the embedded database for local development only (stored in ./.data).
DATABASE_URL=
# Set to "false" to turn TLS off (for example a Postgres on the same private network).
# Otherwise TLS is used for any host that is not localhost.
DATABASE_SSL=
DATABASE_POOL_MAX=10
# "true" applies pending migrations when the server starts. Otherwise run: npm run db:migrate
AUTO_MIGRATE=false
# Production safety stop: the embedded database is refused in production unless this is "true".
# Only ever use it for one long-lived server with a persistent disk. Not for serverless hosting.
ALLOW_EMBEDDED_DB=false

# ---------------------------------------------------------------- Site
# The public address of the site, no trailing slash. Used in email links and to restrict form posts.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- Email
# Optional locally, effectively required in production: without it, verification and password-reset
# emails cannot be delivered. Example: smtps://username:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Subdesk <no-reply@example.com>"
# "false" lets users skip email verification (an administrator can also mark an email as verified).
EMAIL_VERIFICATION_REQUIRED=true

# ---------------------------------------------------------------- Reddit API (optional)
# Create an app at https://www.reddit.com/prefs/apps (type: "web app" or "script").
# Without these, every application is flagged "Manual Review Required" and an administrator
# enters the verified values by hand. Nothing is faked.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent. Use your own app name and Reddit username, e.g.
# web:your-app-name:v1.0 (by /u/your_reddit_username)
REDDIT_USER_AGENT=

# ---------------------------------------------------------------- First administrator
# Only read by `npm run admin:create` (it can also prompt for them). Do not keep the password in a file.
# ADMIN_EMAIL=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
